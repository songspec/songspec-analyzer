{
  "$defs": {
    "ChordSegment": {
      "additionalProperties": true,
      "properties": {
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "chord": {
          "description": "'Bbm', 'Ebmaj7', 'C/E'; 'N' = no chord",
          "title": "Chord",
          "type": "string"
        },
        "triad": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the chord reduced to a triad, for the simplify toggle",
          "title": "Triad"
        },
        "roman": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roman"
        },
        "bass": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bass"
        },
        "conf": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conf"
        },
        "on_downbeat": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Downbeat"
        }
      },
      "required": [
        "start",
        "end",
        "chord"
      ],
      "title": "ChordSegment",
      "type": "object"
    },
    "ChordSummaryItem": {
      "additionalProperties": true,
      "properties": {
        "chord": {
          "title": "Chord",
          "type": "string"
        },
        "seconds": {
          "title": "Seconds",
          "type": "number"
        },
        "count": {
          "default": 0,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "chord",
        "seconds"
      ],
      "title": "ChordSummaryItem",
      "type": "object"
    },
    "Chords": {
      "additionalProperties": true,
      "properties": {
        "segments": {
          "items": {
            "$ref": "#/$defs/ChordSegment"
          },
          "title": "Segments",
          "type": "array"
        },
        "summary": {
          "items": {
            "$ref": "#/$defs/ChordSummaryItem"
          },
          "title": "Summary",
          "type": "array"
        },
        "progressions": {
          "items": {
            "$ref": "#/$defs/Progression"
          },
          "title": "Progressions",
          "type": "array"
        },
        "vocabulary": {
          "items": {
            "type": "string"
          },
          "title": "Vocabulary",
          "type": "array"
        }
      },
      "title": "Chords",
      "type": "object"
    },
    "Detune": {
      "additionalProperties": true,
      "properties": {
        "cents": {
          "description": "reference-pitch offset from A440, wrapped to [-50, 50), 0.1 ¢ resolution",
          "title": "Cents",
          "type": "number"
        },
        "ci_cents": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "95 % confidence half-width",
          "title": "Ci Cents"
        },
        "confidence": {
          "description": "0..1",
          "title": "Confidence",
          "type": "number"
        },
        "semitones": {
          "default": 0,
          "description": "whole semitones of transposition when known (else 0)",
          "title": "Semitones",
          "type": "integer"
        },
        "total_cents": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Cents"
        },
        "a4_hz": {
          "title": "A4 Hz",
          "type": "number"
        },
        "drift": {
          "description": "tuning per window; meaningful when drift_flag",
          "items": {
            "$ref": "#/$defs/DriftPoint"
          },
          "title": "Drift",
          "type": "array"
        },
        "drift_flag": {
          "default": false,
          "description": "the tuning moves by more than 5 cents over the song",
          "title": "Drift Flag",
          "type": "boolean"
        },
        "drift_range_cents": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "p95 - p5 of the 10 s windows around the song's tuning",
          "title": "Drift Range Cents"
        },
        "secondary": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a second tuning in the mix (e.g. an 808 off the rest): {cents, share}",
          "title": "Secondary"
        },
        "estimators": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "each estimator's vote, cents",
          "title": "Estimators",
          "type": "object"
        },
        "fusion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'centsible' (its interval was tight) or 'weighted circular median'",
          "title": "Fusion"
        },
        "locked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Centsible's LOCKED state: interval <= 0.3 cents and steady",
          "title": "Locked"
        },
        "competing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "two tunings carry about the same evidence (e.g. a sampled loop under the vocal)",
          "title": "Competing"
        },
        "display": {
          "anyOf": [
            {
              "$ref": "#/$defs/DetuneDisplay"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "cents",
        "confidence",
        "a4_hz"
      ],
      "title": "Detune",
      "type": "object"
    },
    "DetuneDisplay": {
      "additionalProperties": true,
      "properties": {
        "display": {
          "description": "'+23.4 ¢'",
          "title": "Display",
          "type": "string"
        },
        "fix": {
          "description": "'pitch by −23.4 ¢ to fix'",
          "title": "Fix",
          "type": "string"
        },
        "a4_hz": {
          "title": "A4 Hz",
          "type": "number"
        },
        "semitones": {
          "default": 0,
          "title": "Semitones",
          "type": "integer"
        },
        "total_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'+1 semitone, −18.0 ¢' when the full transposition is known",
          "title": "Total Text"
        },
        "key_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'Plays in Bb Minor (+38.0 ¢ above Bb). If you pitch down 38.0 ¢, ...'",
          "title": "Key Text"
        }
      },
      "required": [
        "display",
        "fix",
        "a4_hz"
      ],
      "title": "DetuneDisplay",
      "type": "object"
    },
    "DriftPoint": {
      "additionalProperties": true,
      "properties": {
        "t": {
          "description": "window centre, seconds",
          "title": "T",
          "type": "number"
        },
        "cents": {
          "title": "Cents",
          "type": "number"
        },
        "ci": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "95 % half-width, cents",
          "title": "Ci"
        }
      },
      "required": [
        "t",
        "cents"
      ],
      "title": "DriftPoint",
      "type": "object"
    },
    "Key": {
      "additionalProperties": true,
      "properties": {
        "tonic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "flat spelling, 'Bb'",
          "title": "Tonic"
        },
        "scale": {
          "anyOf": [
            {
              "enum": [
                "major",
                "minor"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale"
        },
        "mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'Phrygian' etc. when it clearly beats plain major/minor; else null",
          "title": "Mode"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "calibrated probability of the top key, 0..1",
          "title": "Confidence"
        },
        "ambiguous": {
          "default": false,
          "title": "Ambiguous",
          "type": "boolean"
        },
        "camelot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camelot"
        },
        "open_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Open Key"
        },
        "candidates": {
          "description": "top 3",
          "items": {
            "$ref": "#/$defs/KeyCandidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/KeySection"
          },
          "title": "Sections",
          "type": "array"
        },
        "modulations": {
          "description": "[{t, from, to, kind}] e.g. kind 'half-step lift'",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Modulations",
          "type": "array"
        },
        "borrows": {
          "description": "'May borrow from': outside chords traced to the scale they come from (parallel modes, harmonic/melodic minor, the relative minor's harmonic minor)",
          "items": {
            "$ref": "#/$defs/KeyBorrow"
          },
          "title": "Borrows",
          "type": "array"
        },
        "corrected": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyCorrection"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "set when a user corrected the key; the other fields then show the corrected key"
        },
        "estimators": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "description": "each estimator's top key and probability",
          "title": "Estimators",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "description": "{'hooktheory': {key, bpm, url, agrees}}",
          "title": "Metadata",
          "type": "object"
        },
        "preliminary": {
          "default": false,
          "description": "true while only the quick key exists (Centsible's detector); the fused key replaces it",
          "title": "Preliminary",
          "type": "boolean"
        },
        "display": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyDisplay"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Key",
      "type": "object"
    },
    "KeyBorrow": {
      "additionalProperties": true,
      "properties": {
        "from": {
          "description": "house style, e.g. 'C Mixolydian', 'C Minor', 'A Harmonic Minor'",
          "title": "From",
          "type": "string"
        },
        "tonic": {
          "description": "'C'",
          "title": "Tonic",
          "type": "string"
        },
        "mode": {
          "description": "scale id: 'mixolydian', 'aeolian', 'harmonic_minor', 'phrygian', ...",
          "title": "Mode",
          "type": "string"
        },
        "chords": {
          "description": "the outside chords it explains, longest first: ['Bb', 'Bb7']",
          "items": {
            "type": "string"
          },
          "title": "Chords",
          "type": "array"
        },
        "seconds": {
          "description": "how long those chords are held in total",
          "title": "Seconds",
          "type": "number"
        },
        "share": {
          "description": "that time as a share of the song's chord time, 0..1",
          "title": "Share",
          "type": "number"
        }
      },
      "required": [
        "from",
        "tonic",
        "mode",
        "seconds",
        "share"
      ],
      "title": "KeyBorrow",
      "type": "object"
    },
    "KeyCandidate": {
      "additionalProperties": true,
      "properties": {
        "key": {
          "description": "house style, e.g. 'Bb Minor'",
          "title": "Key",
          "type": "string"
        },
        "p": {
          "title": "P",
          "type": "number"
        }
      },
      "required": [
        "key",
        "p"
      ],
      "title": "KeyCandidate",
      "type": "object"
    },
    "KeyCorrection": {
      "additionalProperties": true,
      "properties": {
        "key": {
          "description": "the corrected key in house style, 'Bb Minor*'",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "description": "what the user picked, 'A# Phrygian'",
          "title": "Value",
          "type": "string"
        },
        "at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "unix time of the correction",
          "title": "At"
        },
        "by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the X-SongSpec-User header sent with it, if any",
          "title": "By"
        },
        "detected": {
          "additionalProperties": true,
          "description": "the analyzer's own key fields before the correction",
          "title": "Detected",
          "type": "object"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "KeyCorrection",
      "type": "object"
    },
    "KeyDisplay": {
      "additionalProperties": true,
      "properties": {
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'Bb Minor*', 'C Minor* / C Major'",
          "title": "Key"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'A# Phrygian', 'Intro in C Phrygian Dominant, Verses & Choruses in C Major', 'D Dorian - May borrow from D Mixolydian'",
          "title": "Note"
        },
        "ambiguity_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'ambiguous between C Major and A Minor' when confidence is low",
          "title": "Ambiguity Text"
        }
      },
      "title": "KeyDisplay",
      "type": "object"
    },
    "KeySection": {
      "additionalProperties": true,
      "properties": {
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "key": {
          "description": "full name incl. mode, e.g. 'C Phrygian Dominant'",
          "title": "Key",
          "type": "string"
        },
        "display": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "house style, e.g. 'C Minor*'",
          "title": "Display"
        }
      },
      "required": [
        "start",
        "end",
        "key"
      ],
      "title": "KeySection",
      "type": "object"
    },
    "Progress": {
      "additionalProperties": true,
      "properties": {
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "message": {
          "description": "Human-readable, e.g. 'Finding beats...'",
          "title": "Message",
          "type": "string"
        },
        "fraction": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0..1 within the stage, when known",
          "title": "Fraction"
        }
      },
      "required": [
        "stage",
        "message"
      ],
      "title": "Progress",
      "type": "object"
    },
    "Progression": {
      "additionalProperties": true,
      "properties": {
        "roman": {
          "description": "'i-VI-III-VII'",
          "title": "Roman",
          "type": "string"
        },
        "chords": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'Bbm-Gb-Db-Ab'",
          "title": "Chords"
        },
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "display": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'i–VI–III–VII ×8'",
          "title": "Display"
        }
      },
      "required": [
        "roman",
        "count"
      ],
      "title": "Progression",
      "type": "object"
    },
    "Tempo": {
      "additionalProperties": true,
      "properties": {
        "bpm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "house-rule BPM (80-160 unless compound meter), 2 decimals",
          "title": "Bpm"
        },
        "bpm_raw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the felt tempo as detected",
          "title": "Bpm Raw"
        },
        "bpm_source": {
          "default": "audio",
          "enum": [
            "audio",
            "hooktheory"
          ],
          "title": "Bpm Source",
          "type": "string"
        },
        "alternates": {
          "items": {
            "type": "number"
          },
          "title": "Alternates",
          "type": "array"
        },
        "signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature"
        },
        "signature_conf": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature Conf"
        },
        "compound": {
          "default": false,
          "title": "Compound",
          "type": "boolean"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/TempoSection"
          },
          "title": "Sections",
          "type": "array"
        },
        "range": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "[lo, hi] house-rule BPM when played live",
          "title": "Range"
        },
        "irregularity_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "std / mean of the beat intervals, %",
          "title": "Irregularity Pct"
        },
        "drift_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "how far the smoothed tempo moves over the song (p95 - p5), %",
          "title": "Drift Pct"
        },
        "feel": {
          "anyOf": [
            {
              "enum": [
                "grid",
                "live"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'live' = played live / drifting, 'grid' = quantized",
          "title": "Feel"
        },
        "beats": {
          "items": {
            "type": "number"
          },
          "title": "Beats",
          "type": "array"
        },
        "downbeats": {
          "items": {
            "type": "number"
          },
          "title": "Downbeats",
          "type": "array"
        },
        "curve": {
          "$ref": "#/$defs/TempoCurve",
          "description": "per-beat tempo, at most 1500 points"
        },
        "display": {
          "anyOf": [
            {
              "$ref": "#/$defs/TempoDisplay"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Tempo",
      "type": "object"
    },
    "TempoCurve": {
      "additionalProperties": true,
      "properties": {
        "t": {
          "items": {
            "type": "number"
          },
          "title": "T",
          "type": "array"
        },
        "bpm": {
          "items": {
            "type": "number"
          },
          "title": "Bpm",
          "type": "array"
        }
      },
      "title": "TempoCurve",
      "type": "object"
    },
    "TempoDisplay": {
      "additionalProperties": true,
      "properties": {
        "bpm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'114', '82.5', '~122 - 127'",
          "title": "Bpm"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'BPM inconsistent - played live', 'Played in 6/8 time signature'",
          "title": "Note"
        },
        "alternates": {
          "description": "½x / 1x / 2x as display strings, for chips",
          "items": {
            "type": "string"
          },
          "title": "Alternates",
          "type": "array"
        }
      },
      "title": "TempoDisplay",
      "type": "object"
    },
    "TempoSection": {
      "additionalProperties": true,
      "description": "One part of the song between beat switches (the usual song has exactly one).",
      "properties": {
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "bpm": {
          "description": "felt BPM of the section (before the house rule)",
          "title": "Bpm",
          "type": "number"
        },
        "lo": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "p10 of the local tempo, felt BPM",
          "title": "Lo"
        },
        "hi": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "p90 of the local tempo, felt BPM",
          "title": "Hi"
        },
        "drift_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "(hi - lo) / median, %",
          "title": "Drift Pct"
        },
        "steadiness": {
          "default": "steady",
          "description": "tracker words: '128' / '~98' / '~97 - 100'",
          "enum": [
            "steady",
            "moderate",
            "live"
          ],
          "title": "Steadiness",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "bpm"
      ],
      "title": "TempoSection",
      "type": "object"
    },
    "Track": {
      "additionalProperties": true,
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "artist": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artist"
        },
        "isrc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isrc"
        },
        "duration": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "seconds",
          "title": "Duration"
        },
        "source": {
          "default": "upload",
          "enum": [
            "upload",
            "spotify-preview",
            "apple-preview",
            "deezer-preview"
          ],
          "title": "Source",
          "type": "string"
        },
        "file_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Name"
        },
        "sample_rate": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Rate"
        },
        "channels": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channels"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Chromaprint (when fpcalc is installed)",
          "title": "Fingerprint"
        }
      },
      "title": "Track",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "GET /v1/analyses/{id}",
  "properties": {
